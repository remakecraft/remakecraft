{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash|PowerShell|NotebookRead|NotebookEdit|WebFetch|WebSearch|Edit|Write|Agent|Task|ListMcpResourcesTool|ReadMcpResourceTool|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard.mjs"],
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/audit.mjs"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
